'),c=>c.charCodeAt(0));
const $=id=>document.getElementById(id),log=t=>{$('log').textContent+=t+'\n';};
let image;
async function verify(){if(!globalThis.crypto?.subtle)throw Error('Open the published HTTPS installer: package verification requires a secure context.');if(bytes.length!==META.size)throw Error('Pinned package size mismatch');const digest=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',bytes)),x=>x.toString(16).padStart(2,'0')).join('');if(digest!==META.sha256)throw Error('Pinned package SHA256 mismatch');if(productOf(bytes)!==META.product)throw Error('Wrong product identity');image=logicalImage(bytes);$('title').textContent='Install EIN-1 '+META.version;$('install').disabled=false;$('install').textContent='Install '+META.version;$('status').textContent='Package verified · '+META.product;log('SHA256 '+digest);}
$('install').onclick=async()=>{let updater,verified=false;try{$('install').disabled=true;if(!navigator.requestMIDIAccess)throw Error('This browser does not expose Web MIDI SysEx. Use a compatible browser and USB host connection.');await verify();verified=true;$('install').disabled=true;const midi=await navigator.requestMIDIAccess({sysex:true});updater=new Updater(midi);const step=(stage,detail)=>{const names={start:'Enter update mode',verify:'Verify / stage loader',loader:'Discover EIN loader',write:'Flash / verify sectors',reboot:'Reboot / confirm identity',done:'Installed identity confirmed'};$('status').textContent=(names[stage]||stage)+(detail!==undefined?' · '+detail:'');if(stage==='write')$('progress').value=Math.min(95,10+Number(detail)/3000*80);if(stage==='done')$('progress').value=100;if(['start','loader','reboot','done'].includes(stage))log($('status').textContent);};if(!await updater.resume(image,step,{product:META.product}))await updater.install(image,META.product,step);log('Success: '+META.product+' confirmed. Physical sound, controls, banks and A→B→C tests remain to be completed.');}catch(e){$('status').textContent=e.message;log((e.code||'error')+': '+e.message+(e.detail?' · '+e.detail:''));}finally{$('install').disabled=!verified;}};
verify().catch(e=>{$('status').textContent=e.message;});
</script></body></html>
