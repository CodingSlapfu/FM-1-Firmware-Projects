<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>EIN-1 · Install 0.32.0</title><style>body{font:16px/1.6 system-ui;background:#0b1012;color:#edf5f2;max-width:760px;margin:60px auto;padding:20px}a{color:#91efcb}button{font:inherit;background:#91efcb;color:#08251b;border:0;border-radius:8px;padding:13px 24px;margin:15px 0}button:disabled{opacity:.4}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#162125;padding:20px}progress{width:100%}.tag{color:#e5c593}</style><body><a href="./">EIN-1 release</a><p class="tag">INTERNAL ENGINEERING BUILD · INCOMPLETE</p><h1 id="title">Install EIN-1</h1><p>Back up your universe and native sample banks before installing. Close the emulator, Mirror and other MIDI applications. Keep USB power connected throughout the update.</p><p><strong>Audio-stall repair is unverified on FM1. Nightfall automatic power-off is not implemented. Read the acceptance notes before testing.</strong></p><p>The installer verifies the pinned package, stages the EIN loader, writes and verifies sectors, then checks the installed identity. It only accepts the EIN update loader. No restore-to-stock step is part of a normal EIN update.</p><button id="install" disabled>Verify package…</button><progress id="progress" max="100" value="0"></progress><p id="status" role="status">Loading package verification…</p><pre id="log"></pre><p>If an install was interrupted in the EIN loader, reconnect and press Install to resume with this same package. If the app starts, holding OCT− at power-on enters USB rescue. A damaged boot chain requires the documented ROM/M-UPGRADE recovery procedure.</p><p><a href="HARDWARE_TESTS.md">Hardware tests</a> · <a href="RECOVERY.md">Recovery</a> · <a href="SHA256SUMS.txt">Checksums</a> · <a href="ACCEPTANCE.md">Evidence / limits</a></p><script type="module">
// SPDX-License-Identifier: GPL-3.0-only
// Copyright (C) 2026 Leo Kuroshita (@kurogedelic), Hügelton Instruments
//
// FM-1 .fwsc packages in the browser: the package identity and the image the
// device reads during an update.

const BLOCKS = 20, BLK = 0x30, KEEP = 0x2F;

// the package identity ("FM-1_904"): one marker byte after each of the first 20 blocks
function productOf(fwsc) {
  if (fwsc.length < BLOCKS * BLK) throw new Error("not an FM-1 package (too short)");
  let s = "";
  for (let i = 0; i < BLOCKS; i++) {
    const m = fwsc[i * BLK + KEEP];
    if (m !== 0x7D) s += String.fromCharCode((m - i - 1) & 0xFF);
  }
  return s;
}

// the image the device addresses during an update: the .fwsc without the 20 marker bytes
function logicalImage(fwsc) {
  const out = new Uint8Array(fwsc.length - BLOCKS);
  for (let i = 0; i < BLOCKS; i++) out.set(fwsc.subarray(i * BLK, i * BLK + KEEP), i * KEEP);
  out.set(fwsc.subarray(BLOCKS * BLK), BLOCKS * KEEP);
  return out;
}

// SPDX-License-Identifier: GPL-3.0-only
// Copyright (C) 2026 Leo Kuroshita (@kurogedelic), Hügelton Instruments
//
// The FM-1 USB-MIDI update protocol (M-UPGRADE compatible) over WebMIDI.
// Step 1: the running firmware reads parts of the package and stages the update
// loader. Step 2: the loader reads the whole image and writes it. In both steps
// the device sends cmd 0x30 read requests on the logical image and we answer.

const HS_QUERY = [0xF0, 0x00, 0x32, 0x45, 0x00, 0x00, 0x00, 0x40, 0x7F, 0xF7];
const UPGRADE = [0xF0, 0x22, 0x24, 0x35, 0x7F, 0xF7];
const MAXDATA = 512;
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
const IS_OTA = (id) => /^ota-/i.test(id.model);
// the update loader of SLOOP / Felucca packages ("ota-FM-1_9XX"). A device left in the update mode of another
// firmware (the stock updater's loader) is never written: its loader may lay the image out differently.
const OUR_LOADER = (id) => /^ota-FM-1_928$/i.test(id.text);
// the MIDI ports the installer may probe (never other gear): the FM-1 under SLOOP / Felucca ("Felucca"), under
// CLIPPER ("Clipper", its sister firmware), under a firmware named after itself ("SLOOP"), the update loaders, and
// the names Windows / macOS give the stock firmware
const FM1_PORT = /fm-1|ein|felucca|ota|composite|sinco|usb[- ]midi/i;

// errors carry a code the pages translate: notfound, model, stopped, noloader, lost, noreturn,
// mismatch (detail: the identity the device reports), badreq, foreign (detail: the loader's identity)
function fail(code, msg, detail = "") { const e = new Error(msg); e.code = code; e.detail = detail; return e; }

function pack7(data) {
  const out = []; let acc = 0, nb = 0;
  for (const b of data) {
    acc |= b << nb; nb += 8;
    while (nb >= 7) { out.push(acc & 0x7F); acc >>>= 7; nb -= 7; }
  }
  if (nb) out.push(acc & 0x7F);
  return out;
}

function unpack7(s) {
  const out = []; let acc = 0, nb = 0;
  for (const b of s) {
    acc |= (b & 0x7F) << nb; nb += 7;
    while (nb >= 8) { out.push(acc & 0xFF); acc >>>= 8; nb -= 8; }
  }
  return out;
}

function response(addr, data, fl = 0) {
  const len = data.length;
  const body = [0x00, 0x59, 0x30, (len + 8) & 0xFF, ((len + 8) >> 8) & 0xFF, 0, fl,
    addr & 0xFF, (addr >>> 8) & 0xFF, (addr >>> 16) & 0xFF, (addr >>> 24) & 0xFF,
    len & 0xFF, (len >> 8) & 0xFF, 0, ...data];
  let s = 0;
  for (let i = 6; i < body.length; i++) s += body[i];
  body.push(~s & 0xFF);
  return [0xF0, ...pack7(body), 0xF7];
}

function parseRequest(pkt) {
  if (pkt[0] !== 0xF0 || pkt[pkt.length - 1] !== 0xF7) return null;
  const u = unpack7(pkt.slice(1, -1));
  if (u.length !== 15 || u[0] !== 0 || u[1] !== 0x59 || u[2] !== 0x30) return null;
  let s = 0;
  for (let i = 6; i < 14; i++) s += u[i];
  if ((~s & 0xFF) !== u[14]) return null;
  return { fl: u[6], addr: (u[7] | (u[8] << 8) | (u[9] << 16) | (u[10] << 24)) >>> 0, len: u[11] | (u[12] << 8) | (u[13] << 16) };
}

function parseIdentity(pkt) {
  const d = unpack7(pkt.slice(1, -1));
  if (d.length !== 34 || d[0] !== 0 || d[1] !== 0x59 || d[2] !== 0x11) return null;
  const txt = String.fromCharCode(...d.slice(6, 33)).replace(/\0+$/, "");
  const m = /^([^_]+)_(\d+)$/.exec(txt);
  return m ? { text: txt, model: m[1], version: parseInt(m[2], 10) } : null;
}

// one MIDI in/out pair with a SysEx queue
class Link {
  constructor(input, output) {
    this.input = input; this.output = output; this.q = []; this.waiter = null;
    input.onmidimessage = (ev) => {
      if (ev.data[0] !== 0xF0) return;
      this.q.push(Array.from(ev.data));
      if (this.waiter) { const w = this.waiter; this.waiter = null; w(); }
    };
  }
  get lost() { return this.input.state === "disconnected" || this.output.state === "disconnected"; }
  // false when the port is gone (unplugged): WebMIDI throws on a disconnected output
  send(bytes) {
    try { this.output.send(bytes); return true; } catch (_) { return false; }
  }
  drain() { this.q.length = 0; }
  async read(ms) {
    if (!this.q.length) {
      let tm;
      await Promise.race([new Promise((r) => { this.waiter = r; }), new Promise((r) => { tm = setTimeout(r, ms); })]);
      clearTimeout(tm);
      this.waiter = null;
    }
    return this.q.shift() || null;
  }
  // detach the callback only; do NOT close the MIDI ports. find()/probe() reuse the same input across
  // several output candidates (e.g. the always-present "Microsoft GS Wavetable Synth" is probed before
  // the FM-1's own output), and closing the input between candidates raced its re-open and broke the
  // handshake with a device that is present ("FM-1 not found" with the port listed). Leaving ports open
  // is the long-standing behaviour.
  close() { this.input.onmidimessage = null; }
}

async function handshake(link, tries = 3) {
  link.drain();
  for (let t = 0; t < tries; t++) {
    if (!link.send(HS_QUERY)) return null;
    const end = Date.now() + 1000;
    while (Date.now() < end) {
      const p = await link.read(end - Date.now());
      if (!p) break;
      const id = parseIdentity(p);
      if (id) return id;
    }
  }
  return null;
}

class Updater {
  constructor(access, log) {
    this.access = access;
    this.log = log || (() => {});
  }

  // one input against its candidate outputs: the matching port first (same name, or one name contains
  // the other, so input "Felucca" pairs with output "MIDIOUT2 (Felucca)" without probing unrelated
  // outputs like "Microsoft GS Wavetable Synth"), then (the fallback) any live output. A pair counts
  // only when it answers the FM-1 handshake and passes the filter.
  async probe(input, outs, filter) {
    if (input.state === "disconnected") return null;
    const live = outs.filter((o) => o.state !== "disconnected");
    const nm = input.name || "";
    const named = live.filter((o) => o.name === nm || (nm && o.name && (o.name.includes(nm) || nm.includes(o.name))));
    for (const output of [...named, ...live.filter((o) => !named.includes(o))]) {
      try { await input.open(); await output.open(); } catch (_) { continue; }
      const link = new Link(input, output);
      const id = await handshake(link, 2);
      if (id && (!filter || filter(id))) return { link, id, name: input.name };
      link.close();
    }
    return null;
  }

  // the FM-1 (or its update loader) among the MIDI ports. Named ports first (fast, and other gear is
  // never touched). With deep=true (hunting the re-enumerated update loader only), if no named port
  // matched, the remaining ports are probed too and accepted SOLELY when they answer the FM-1 handshake
  // (other gear returns no valid identity). Windows often names the update loader generically (e.g.
  // "USB MIDI Device"), so a name filter alone misses it and the loader seems to "not appear": this
  // handshake fallback is what makes the loader reliably found, without probing other gear when looking
  // for the running firmware (which always names itself).
  async find(filter, deep = false) {
    const outs = [...this.access.outputs.values()];
    const inputs = [...this.access.inputs.values()].filter((i) => i.state !== "disconnected");
    for (const input of inputs)
      if (FM1_PORT.test(input.name || "")) {
        const dev = await this.probe(input, outs, filter);
        if (dev) return dev;
      }
    if (deep)
      for (const input of inputs)
        if (!FM1_PORT.test(input.name || "")) {
          const dev = await this.probe(input, outs, filter);
          if (dev) return dev;
        }
    return null;
  }

  // the MIDI inputs there are, for the "not found" message: " (MIDI: a, b)" (a port the installer skipped shows)
  seen() {
    const names = [...this.access.inputs.values()].filter((p) => p.state !== "disconnected").map((p) => p.name || "?");
    return names.length ? ` (MIDI: ${names.join(", ")})` : " (MIDI: none)";
  }

  async waitFor(filter, ms, deep = false) {
    const end = Date.now() + ms;
    while (Date.now() < end) {
      const dev = await this.find(filter, deep);
      if (dev) return dev;
      await sleep(1000);
    }
    return null;
  }

  // serve read requests until the device asks for one of the finish addresses; stops early
  // when the port disappears (lost: true) instead of waiting out idleMs
  async serve(link, image, finishAddr, idleMs, onProgress) {
    let served = 0, last = Date.now();
    for (;;) {
      const pkt = await link.read(1000);
      if (!pkt) {
        if (link.lost) return { served, finished: false, lost: true };
        if (Date.now() - last > idleMs) return { served, finished: false };
        continue;
      }
      const r = parseRequest(pkt);
      if (!r) continue;
      last = Date.now();
      if (r.addr === 0xE0000000 || r.addr === 0xF0000000) {
        if (!link.send(response(r.addr, [...new TextEncoder().encode("success"), 0]))) {
          return { served, finished: false, lost: true };
        }
        if (r.addr === finishAddr) return { served, finished: true };
        continue;
      }
      if (r.len > MAXDATA || r.addr + r.len > image.length) throw fail("badreq", `bad request ${r.addr.toString(16)}+${r.len}`);
      await sleep(10);
      if (!link.send(response(r.addr, Array.from(image.subarray(r.addr, r.addr + r.len)), r.fl))) {
        return { served, finished: false, lost: true };
      }
      served++;
      if (onProgress) onProgress(served, r.addr);
    }
  }

  // full install: running firmware -> loader -> new firmware
  async install(image, product, onStep) {
    const step = onStep || (() => {});
    const dev = await this.find((id) => !IS_OTA(id));
    if (!dev) throw fail("notfound", "FM-1 not found (USB cable, and no other app using it?)", this.seen());
    const [model] = product.split("_");
    if (dev.id.model !== model) { dev.link.close(); throw fail("model", `the device is ${dev.id.text}, the package is for ${product}`); }
    step("start", dev.id.text);
    if (!dev.link.send(UPGRADE)) {
      dev.link.close();
      throw fail("lost", "FM-1 disconnected before entering update mode");
    }
    // Answer the first loader-stage read as soon as it arrives.
    const s1 = await this.serve(dev.link, image, 0xE0000000, 8000, (n) => step("verify", n));
    dev.link.close();
    if (!s1.finished) throw fail(s1.lost ? "lost" : "stopped", `the device ${s1.lost ? "was disconnected" : "stopped"} after ${s1.served} requests: nothing was written`);
    step("loader");
    await sleep(3000);
    const ota = await this.waitFor(IS_OTA, 60000, true);
    if (!ota) throw fail("noloader", "the update loader did not appear. Replug the USB cable and press Install again: the device stays in update mode until it is finished.", this.seen());
    if (!OUR_LOADER(ota.id)) { ota.link.close(); throw fail("foreign", "Unexpected update loader: " + ota.id.text, ota.id.text); }
    const s2 = await this.write(ota, image, step);
    if (!s2.finished) throw fail(s2.lost ? "lost" : "stopped", `the loader ${s2.lost ? "was disconnected" : "stopped"} after ${s2.served} requests. Replug and press Install again to resume.`);
    step("reboot");
    await sleep(3000);
    const back = await this.waitFor((id) => !IS_OTA(id) && id.model === model, 60000);
    if (!back) throw fail("noreturn", "the device did not come back: power-cycle it");
    back.link.close();
    if (back.id.text !== product) throw fail("mismatch", `installed, but the device reports ${back.id.text}`, back.id.text);
    step("done", back.id.text);
    return back.id.text;
  }

  // step 2 with the loader found by find()/waitFor()
  async write(ota, image, step) {
    try {
      if (!ota.link.send(UPGRADE)) throw fail("lost", "FM-1 loader disconnected before writing");
      return await this.serve(ota.link, image, 0xF0000000, 180000, (n) => step("write", n));
    } finally {
      ota.link.close();
    }
  }

  // resume: the device is already in update mode (loader) -> true when the write finished. Only SLOOP's
  // own loader is resumed, except for the return to the official firmware (opts.product: the official
  // package, its identity checked once the FM-1 is back, after Felucca 1.0): that one is the official
  // loader's own image, as M-UPGRADE would write it
  async resume(image, onStep, opts = {}) {
    const ota = await this.find(IS_OTA, true);
    if (!ota) return false;
    if (!OUR_LOADER(ota.id)) {
      ota.link.close();
      throw fail("foreign", `the FM-1 is in the update mode of another firmware (${ota.id.text}): finish that update with its own updater`, ota.id.text);
    }
    const step = onStep || (() => {});
    if (!(await this.write(ota, image, step)).finished) return false;
    if (opts.product) {
      const [model] = opts.product.split("_");
      step("reboot");
      await sleep(3000);
      const back = await this.waitFor((id) => !IS_OTA(id) && id.model === model, 60000);
      if (!back) throw fail("noreturn", "the FM-1 did not come back after the write: power-cycle it");
      back.link.close();
      if (back.id.text !== opts.product) throw fail("mismatch", `written, but the FM-1 reports ${back.id.text}`, back.id.text);
      step("done", back.id.text);
    }
    return true;
  }
}

const META={"version": "0.32.0", "product": "FM-1_8003200", "size": 610308, "sha256": "6722107c7ace10bf83847a343b041e375f6bef799f6a26fa2b6315b3df7240ff"};
const bytes=Uint8Array.from(atob('